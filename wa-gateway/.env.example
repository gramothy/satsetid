# Salin menjadi wa-gateway/.env (tidak di-commit). Gateway TIDAK membaca .env Laravel.
# Token dan secret di bawah harus SAMA dengan WHATSAPP_GATEWAY_TOKEN dan
# WHATSAPP_WEBHOOK_SECRET di .env Laravel. Buat nilai acak, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Port HTTP gateway (hanya mendengarkan di 127.0.0.1)
WA_GATEWAY_PORT=3100
# Laravel -> gateway: header Authorization: Bearer <token>
WA_GATEWAY_TOKEN=
# Gateway -> Laravel: pesan masuk, status, dan sesi dikirim ke URL ini
WA_WEBHOOK_URL=http://127.0.0.1:8000/webhooks/baileys
# Kunci HMAC untuk X-Satset-Signature (harus berbeda dari token)
WA_WEBHOOK_SECRET=
# Jeda acak antar pesan keluar (milidetik, maksimal 15000)
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000
# Batas pesan keluar per hari (reset tengah malam WIB)
WA_DAILY_CAP=200
