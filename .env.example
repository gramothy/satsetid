APP_NAME=SatSet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satset
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Daftar antrean langsung dari halaman outlet tanpa WhatsApp (untuk demo)
SATSET_WEB_SIGNUP=false

# WhatsApp chatbot. Bawaan: Baileys lewat wa-gateway (lihat README "Menghubungkan WhatsApp").
# Baileys TIDAK resmi dan melanggar ketentuan WhatsApp; nomor bisa diblokir. Pakai nomor khusus outlet.
WHATSAPP_ENABLED=false
# baileys (bawaan), meta, twilio, atau greenapi
WHATSAPP_PROVIDER=baileys

# Baileys (wa-gateway). Token dan secret harus SAMA dengan wa-gateway/.env
# (WA_GATEWAY_TOKEN dan WA_WEBHOOK_SECRET), minimal 16 karakter, dan berbeda satu sama lain.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3100
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_GATEWAY_TIMEOUT=30

# --- Provider lain (dipakai hanya jika WHATSAPP_PROVIDER=meta, twilio, atau greenapi) ---
# Nomor WhatsApp publik (format 62... / 1...). Untuk Twilio/GREEN-API ini juga nomor pengirim.
# Baileys tidak memakainya: nomornya diambil dari wa-gateway yang tersambung.
WHATSAPP_PHONE_NUMBER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# GREEN-API (tidak resmi: nomor WA biasa yang ditautkan lewat QR; pakai nomor cadangan)
# Webhook: https://<domain>/webhooks/greenapi, webhookUrlToken = GREENAPI_WEBHOOK_TOKEN
GREENAPI_API_URL=
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_WEBHOOK_TOKEN=

# Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_TEMPLATE_THREE_AHEAD=
WHATSAPP_TEMPLATE_ONE_AHEAD=
WHATSAPP_TEMPLATE_CALLED=
WHATSAPP_TEMPLATE_CANCELLED=
